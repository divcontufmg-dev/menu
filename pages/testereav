import pandas as pd
import re
import numpy as np

# --- Configurações ---
TAMANHO_LOTE = 50

def limpar_texto(texto):
    """Padroniza a descrição (Bem_Completo) para facilitar o agrupamento."""
    if pd.isna(texto):
        return ""
    texto = str(texto).upper()
    texto = re.sub(r'[^A-Z0-9\s]', '', texto)
    texto = re.sub(r'\s+', ' ', texto).strip()
    return texto

def processar_base_ufmg(caminho_arquivo):
    """Lê, parametriza, agrupa e divide a base da UFMG em lotes."""
    
    print("Carregando base de dados...")
    # Lê o CSV (ajuste o delimitador e encoding se necessário, dependendo de como o Excel exportou)
    df = pd.read_csv(caminho_arquivo, sep=',', encoding='utf-8') 
    
    print("Processando colunas e extraindo dados...")
    # 1. Limpeza da Descrição
    df['Descricao_Limpa'] = df['Bem_Completo'].apply(limpar_texto)
    
    # 2. Extração da Palavra-Chave (Substantivo principal)
    df['Palavra_Chave'] = df['Descricao_Limpa'].apply(lambda x: x.split()[0] if x else "INDEFINIDO")
    
    # 3. Extração do Ano de Tombamento a partir do 'Cod ATM'
    # O 'Cod ATM' começa com o ano (ex: 19940027499 -> 1994)
    # Convertendo para string e pegando os 4 primeiros caracteres
    df['Ano_Tombamento'] = df['Cod ATM'].astype(str).str[:4]
    
    print("Agrupando itens similares...")
    # 4. Agrupamento Lógico
    # A ordem de ordenação é crucial: primeiro a grande categoria contábil, depois a unidade, o ano e a descrição.
    df = df.sort_values(by=[
        'Título Conta Contábil', 
        'UG', 
        'Ano_Tombamento',
        'Palavra_Chave', 
        'Descricao_Limpa'
    ])
    
    print(f"Quebrando em blocos de {TAMANHO_LOTE} itens...")
    # 5. Geração dos Lotes
    df['Lote_ID'] = np.arange(len(df)) // TAMANHO_LOTE
    
    return df

